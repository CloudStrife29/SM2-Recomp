+extern "C" void sm2_pgxp_set_normalize_depth(int modo) { s_sm2_norm = modo < 0 ? 0 : (modo > 2 ? 2 : modo); }
+extern "C" int sm2_pgxp_normalize_depth(void) { return sm2_norm_modo(); }
+extern "C" unsigned long long sm2_pgxp_depth_normalized(void) { return s_sm2_norm_n; }
