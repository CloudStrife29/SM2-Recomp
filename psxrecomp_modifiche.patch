+typedef LONG (APIENTRY *Sm2KmtRigaFn)(Sm2KmtRiga *);
+typedef LONG (APIENTRY *Sm2KmtChiudiFn)(Sm2KmtChiudi *);
+static Sm2KmtApriFn s_sm2_kmt_apri = nullptr;
+static Sm2KmtRigaFn s_sm2_kmt_riga = nullptr;
+static Sm2KmtChiudiFn s_sm2_kmt_chiudi = nullptr;
+static std::atomic<unsigned> s_sm2_adattatore{0}, s_sm2_sorgente{0};
+static std::atomic<int> s_sm2_scan_ok{0};
+static int s_sm2_scan_stato = 0;      /* 0 da aprire, 1 aperto, -1 non disponibile */
+static HMONITOR s_sm2_monitor = nullptr;
+static unsigned s_sm2_righe = 0, s_sm2_attive = 0;   /* righe totali e attive del modo video (QueryDisplayConfig) */
+static std::atomic<unsigned> s_sm2_swap_seq{0}, s_sm2_swap_riga{0}, s_sm2_swap_vb{0};
+static std::atomic<uint64_t> s_sm2_swap_inizio{0}, s_sm2_swap_durata{0}, s_sm2_swap_quanti{0};
+static int s_sm2_aggancio = 1;        /* 0: correzione spenta (swap che aspetta il refresh, o aggancio che non converge) */
+
+struct Sm2RitmoStat {
+    uint64_t frame, ultimo_swap, n, attraversamenti, salti, n_tot, attraversamenti_tot;
+    uint64_t durata0, quanti0;        /* durata degli swap e quanti, all'inizio della finestra */
+    double somma, somma2, corr;
+    unsigned righe_viste, vb_da;
+    double fase_prec;
+    uint32_t seq_visto;
+    int fonte_log;
+};
+static Sm2RitmoStat s_sm2_st;
+
+static void sm2_ritmo_azzera(void) {
+    s_sm2_st = Sm2RitmoStat{};
+    s_sm2_st.vb_da = 0xFFFFFFFFu;
+    s_sm2_st.fase_prec = -1.0;
+    s_sm2_st.seq_visto = s_sm2_swap_seq.load(std::memory_order_acquire);
+    s_sm2_st.durata0 = s_sm2_swap_durata.load();
+    s_sm2_st.quanti0 = s_sm2_swap_quanti.load();
+    s_sm2_aggancio = 1;
+}
+
+static int sm2_leggi_riga(unsigned *riga, unsigned *vb) {
+    if (!s_sm2_scan_ok.load(std::memory_order_acquire) || !s_sm2_kmt_riga)
+        return 0;
+    Sm2KmtRiga r{};
+    r.hAdapter = s_sm2_adattatore.load(std::memory_order_relaxed);
+    r.VidPnSourceId = s_sm2_sorgente.load(std::memory_order_relaxed);
+    if (s_sm2_kmt_riga(&r) != 0)
+        return 0;
+    *riga = r.ScanLine;
+    *vb = r.InVerticalBlank ? 1u : 0u;
+    return 1;
+}
+
+/* Chiamata dal disegno OpenGL subito prima (dopo = 0) e subito dopo (dopo = 1) ogni swap, dal thread che fa lo swap
+ * (principale, di disegno o di presentazione): la riga dello schermo prima e quanto e' durato lo swap. */
+extern "C" void sm2_ritmo_swap(int dopo) {
+    if (!s_sm2_k.load(std::memory_order_relaxed))
+        return;
+    const uint64_t ora = SDL_GetPerformanceCounter();
+    if (dopo) {
+        const uint64_t inizio = s_sm2_swap_inizio.exchange(0);
+        if (inizio && ora > inizio) {
+            s_sm2_swap_durata.fetch_add(ora - inizio, std::memory_order_relaxed);
+            s_sm2_swap_quanti.fetch_add(1, std::memory_order_relaxed);
+        }
+        return;
+    }
+    unsigned riga = 0, vb = 0;
+    if (!sm2_leggi_riga(&riga, &vb))
+        return;
+    s_sm2_swap_riga.store(riga, std::memory_order_relaxed);
+    s_sm2_swap_vb.store(vb, std::memory_order_relaxed);
+    s_sm2_swap_seq.fetch_add(1, std::memory_order_release);
+    s_sm2_swap_inizio.store(SDL_GetPerformanceCounter(), std::memory_order_relaxed);
+}
+
+static void sm2_scan_chiudi(void) {
+    if (s_sm2_scan_ok.exchange(0) && s_sm2_kmt_chiudi) {
+        Sm2KmtChiudi c{};
+        c.hAdapter = s_sm2_adattatore.load();
+        s_sm2_kmt_chiudi(&c);
+    }
+}
+
+/* Righe totali e attive del modo video del monitor (le stesse di QueryDisplayConfig: per esempio 1765 e 1600). */
+static void sm2_righe_del_modo(const wchar_t *dispositivo) {
+    s_sm2_righe = s_sm2_attive = 0;
+    UINT32 np = 0, nm = 0;
+    if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &np, &nm) != ERROR_SUCCESS || !np || !nm)
+        return;
+    std::vector<DISPLAYCONFIG_PATH_INFO> percorsi(np);
+    std::vector<DISPLAYCONFIG_MODE_INFO> modi(nm);
+    if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &np, percorsi.data(), &nm, modi.data(), nullptr) != ERROR_SUCCESS)
+        return;
+    for (UINT32 i = 0; i < np; i++) {
+        DISPLAYCONFIG_SOURCE_DEVICE_NAME sn{};
+        sn.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+        sn.header.size = sizeof(sn);
+        sn.header.adapterId = percorsi[i].sourceInfo.adapterId;
+        sn.header.id = percorsi[i].sourceInfo.id;
+        if (DisplayConfigGetDeviceInfo(&sn.header) != ERROR_SUCCESS || lstrcmpW(sn.viewGdiDeviceName, dispositivo) != 0)
+            continue;
+        const UINT32 m = percorsi[i].targetInfo.modeInfoIdx;
+        if (m == DISPLAYCONFIG_PATH_MODE_IDX_INVALID || m >= nm ||
+            modi[m].infoType != DISPLAYCONFIG_MODE_INFO_TYPE_TARGET)
+            continue;
+        const DISPLAYCONFIG_VIDEO_SIGNAL_INFO &v = modi[m].targetMode.targetVideoSignalInfo;
+        if (v.totalSize.cy > v.activeSize.cy && v.activeSize.cy > 0) {
+            s_sm2_righe = v.totalSize.cy;
+            s_sm2_attive = v.activeSize.cy;
+        }
+        return;
+    }
+}
+
+static void sm2_scan_apri(void) {
+    if (!s_sm2_kmt_apri) {
+        HMODULE g = GetModuleHandleW(L"gdi32.dll");
+        if (!g)
+            g = LoadLibraryW(L"gdi32.dll");
+        if (g) {
+            s_sm2_kmt_apri = (Sm2KmtApriFn)(void *)GetProcAddress(g, "D3DKMTOpenAdapterFromHdc");
+            s_sm2_kmt_riga = (Sm2KmtRigaFn)(void *)GetProcAddress(g, "D3DKMTGetScanLine");
+            s_sm2_kmt_chiudi = (Sm2KmtChiudiFn)(void *)GetProcAddress(g, "D3DKMTCloseAdapter");
+        }
+        if (!s_sm2_kmt_apri || !s_sm2_kmt_riga || !s_sm2_kmt_chiudi) {
+            s_sm2_scan_stato = -1;
+            std::printf("psxrecomp: SM2 ritmo: D3DKMT non disponibile, ritmo multiplo senza aggancio\n");
+            return;
+        }
+    }
+    HWND hwnd = sdl_window ? (HWND)SDL_GetPointerProperty(SDL_GetWindowProperties(sdl_window),
+                                                         SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr) : nullptr;
+    if (!hwnd)
+        return;                       /* finestra non ancora pronta: si riprova al prossimo fotogramma */
+    HMONITOR mon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+    MONITORINFOEXW mi{};
+    mi.cbSize = sizeof(mi);
+    if (!mon || !GetMonitorInfoW(mon, (MONITORINFO *)&mi)) {
+        s_sm2_scan_stato = -1;
+        return;
+    }
+    HDC dc = CreateDCW(nullptr, mi.szDevice, nullptr, nullptr);
+    if (!dc) {
+        s_sm2_scan_stato = -1;
+        return;
+    }
+    Sm2KmtApri a{};
+    a.hDc = dc;
+    const LONG st = s_sm2_kmt_apri(&a);
+    DeleteDC(dc);
+    sm2_scan_chiudi();
+    if (st != 0) {
+        s_sm2_scan_stato = -1;
+        std::printf("psxrecomp: SM2 ritmo: riga dello schermo non disponibile (0x%lx), ritmo multiplo senza aggancio\n",
+                    (unsigned long)st);
+        return;
+    }
+    sm2_righe_del_modo(mi.szDevice);
+    s_sm2_adattatore.store(a.hAdapter);
+    s_sm2_sorgente.store(a.VidPnSourceId);
+    s_sm2_scan_ok.store(1, std::memory_order_release);
+    s_sm2_monitor = mon;
+    s_sm2_scan_stato = 1;
+    sm2_ritmo_azzera();
+    char nome[64] = "";
+    WideCharToMultiByte(CP_UTF8, 0, mi.szDevice, -1, nome, (int)sizeof(nome), nullptr, nullptr);
+    std::printf("psxrecomp: SM2 ritmo: riga dello schermo da %s (righe %u, attive %u%s)\n", nome,
+                s_sm2_righe, s_sm2_attive, s_sm2_righe ? "" : ": dalle letture");
+}
+
+/* Dopo l'attesa del pacer (thread principale): campione, statistiche e, con l'aggancio, correzione della prossima
+ * scadenza. atteso: tick passati ad aspettare (0 = fotogramma in ritardo, niente correzione). */
+static void sm2_ritmo_dopo_attesa(FramePacer *p, uint64_t atteso) {
+    const int k = s_sm2_k.load(std::memory_order_relaxed);
+    if (!k || s_sm2_scan_stato < 0)
+        return;
+    if (s_sm2_scan_stato == 0) {
+        sm2_scan_apri();
+        if (s_sm2_scan_stato != 1)
+            return;
+    }
+    Sm2RitmoStat &st = s_sm2_st;
+    st.frame++;
+    if ((st.frame & 255u) == 0 && sdl_window) {      /* la finestra e' passata su un altro schermo? */
+        HWND hwnd = (HWND)SDL_GetPointerProperty(SDL_GetWindowProperties(sdl_window),
+                                                 SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr);
+        if (hwnd && MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST) != s_sm2_monitor) {
+            s_sm2_scan_stato = 0;
+            return;
+        }
+    }
+    unsigned riga = 0, vb = 0;
+    int fonte;
+    const uint32_t seq = s_sm2_swap_seq.load(std::memory_order_acquire);
+    if (seq != st.seq_visto) {
+        st.seq_visto = seq;
+        riga = s_sm2_swap_riga.load(std::memory_order_relaxed);
+        vb = s_sm2_swap_vb.load(std::memory_order_relaxed);
+        st.ultimo_swap = st.frame;
+        fonte = 1;
+    } else if (st.frame - st.ultimo_swap > 30) {    /* nessuno swap OpenGL (Vulkan): fase all'uscita dal pacer */
+        if (!sm2_leggi_riga(&riga, &vb))
+            return;
+        fonte = 2;
+    } else {
+        return;
+    }
+    if (riga + 1 > st.righe_viste)
+        st.righe_viste = riga + 1;
+    if (vb && riga < st.vb_da)
+        st.vb_da = riga;
+    unsigned righe = s_sm2_righe, inizio_vb = s_sm2_attive;
+    if (!righe) {                     /* senza QueryDisplayConfig: dalle letture */
+        righe = st.righe_viste;
+        inizio_vb = st.vb_da;
+        if (st.frame < 240 || inizio_vb == 0xFFFFFFFFu || inizio_vb >= righe || righe < 100)
+            return;
+    }
+    if (riga >= righe)
+        riga = righe - 1;
+    const double fase = (double)((riga + righe - inizio_vb) % righe) / (double)righe;  /* 0 = inizio del vblank */
+    double err = fase - 0.5;
+    if (st.fase_prec >= 0.0) {
+        if ((st.fase_prec > 0.75 && fase < 0.25) || (st.fase_prec < 0.25 && fase > 0.75))
+            st.attraversamenti++;
+        double d = fase - st.fase_prec;
+        d -= std::floor(d + 0.5);
+        if (std::fabs(d) > 0.25)
+            st.salti++;
+    }
+    st.fase_prec = fase;
+    st.n++;
+    st.somma += fase;
+    st.somma2 += fase * fase;
+    const double freq_swap = (double)SDL_GetPerformanceFrequency();
+    const uint64_t q_swap = s_sm2_swap_quanti.load(std::memory_order_relaxed) - st.quanti0;
+    const double durata_swap_ms = q_swap ? 1000.0 * (double)(s_sm2_swap_durata.load(std::memory_order_relaxed) -
+                                                             st.durata0) / (double)q_swap / freq_swap : 0.0;
+    if (s_sm2_modo == 3 && s_sm2_aggancio && q_swap >= 60 && s_sm2_hz > 0.0 &&
+        durata_swap_ms > 0.25 * 1000.0 / s_sm2_hz) {
+        s_sm2_aggancio = 0;
+        std::printf("psxrecomp: SM2 ritmo: lo swap aspetta il refresh (%.2f ms in media): niente correzione, resta il "
+                    "ritmo 1/%d del refresh\n", durata_swap_ms, k);
+        std::fflush(stdout);
+    }
+    if (s_sm2_modo == 3 && s_sm2_aggancio && atteso > 0 && s_sm2_hz > 0.0) {
+        const double tr_ms = 1000.0 / s_sm2_hz;
+        double corr_ms = -0.08 * err * tr_ms;
+        const double lim = 0.03 * tr_ms;
+        if (corr_ms > lim) corr_ms = lim;
+        if (corr_ms < -lim) corr_ms = -lim;
+        const double freq = (double)SDL_GetPerformanceFrequency();
+        const int64_t delta = (int64_t)(corr_ms * freq / 1000.0);
+        p->next_deadline = (uint64_t)((int64_t)p->next_deadline + delta);
+        st.corr += corr_ms;
+    }
+    st.fonte_log = fonte;
+    if (st.n >= 600) {
+        const double media = st.somma / (double)st.n;
+        double var = st.somma2 / (double)st.n - media * media;
+        if (var < 0.0) var = 0.0;
+        st.n_tot += st.n;
+        st.attraversamenti_tot += st.attraversamenti;
+        const double corr_media_us = st.n ? 1000.0 * st.corr / (double)st.n : 0.0;
+        std::printf("psxrecomp: SM2 ritmo k=%d %s: swap a %.3f del refresh dal vblank (dev %.3f), attraversamenti %llu "
+                    "(%llu in tutto), salti %llu, correzione media %+.2f us, %llu campioni (%s), righe %u/%u, swap "
+                    "%.2f ms\n",
+                    k, s_sm2_modo == 3 ? (s_sm2_aggancio ? "agganciato" : "multiplo (aggancio spento)") :
+                    (s_sm2_modo == 2 ? "multiplo senza aggancio" : "misura"),
+                    media, std::sqrt(var), (unsigned long long)st.attraversamenti,
+                    (unsigned long long)st.attraversamenti_tot, (unsigned long long)st.salti, corr_media_us,
+                    (unsigned long long)st.n, fonte == 1 ? "swap" : "pacer", inizio_vb, righe, durata_swap_ms);
+        if (s_sm2_modo == 3 && s_sm2_aggancio && s_sm2_hz > 0.0 &&
+            std::fabs(corr_media_us) > 0.001 * k * 1e6 / s_sm2_hz) {
+            s_sm2_aggancio = 0;
+            std::printf("psxrecomp: SM2 ritmo: l'aggancio non converge (correzione media %+.2f us): niente correzione, "
+                        "resta il ritmo 1/%d del refresh\n", corr_media_us, k);
+        }
+        std::fflush(stdout);
+        st.n = 0;
+        st.attraversamenti = st.salti = 0;
+        st.somma = st.somma2 = st.corr = 0.0;
+        st.durata0 = s_sm2_swap_durata.load();
+        st.quanti0 = s_sm2_swap_quanti.load();
+    }
+}
+#else
+static void sm2_ritmo_dopo_attesa(FramePacer *p, uint64_t atteso) {
+    (void)p;
+    (void)atteso;
+}
+#endif
