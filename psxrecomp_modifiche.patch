+ *    - colore: l'MDEC usa lo stesso colore per ogni quadretto di 2x2 pixel (quadretti colorati sui contorni saturi):
+ *      qui il colore di ogni pixel e' interpolato tra i centri dei quadretti vicini, senza toccare la luminanza;
+ *    la griglia dei blocchi (dove il gioco mette il filmato nell'immagine) si trova da sola.
+ * 2. Nella scheda video (u_sharp == 4 in PRESENT_FS): ingrandimento che segue i contorni con un po' di nitidezza e
+ *    senza aloni.
+ * PSX_SM2_FILTRO_FILMATI: 1 tutto, 2 solo l'ingrandimento, 3 solo la parte sul processore (per le prove). */
+#define SM2_MODO_FILTRO 4
+uint32_t mdec_sm2_qscale(void);        /* mdec.c (SM2-Recomp): quantizzazione dell'ultimo blocco decodificato */
+uint32_t mdec_get_decode_count(void);  /* mdec.c */
+
+typedef struct {
+    int letto, modo;              /* PSX_SM2_FILTRO_FILMATI: 0 spento, 1 tutto, 2 solo GPU, 3 solo processore */
+    int w, h;                     /* ultimo fotogramma */
+    size_t cap, cap_c;            /* capienza dei buffer: pixel e quadretti */
+    uint32_t *src, *out;          /* copia dell'ultimo fotogramma ricevuto e risultato */
+    int16_t *Y, *Yd;              /* luminanza 0..255 prima e dopo lo sblocco */
+    float *cb, *cr;               /* colore medio dei quadretti 2x2 (BT.601) */
+    int16_t *cbi, *cri, *cbd, *crd; /* lo stesso arrotondato, prima e dopo lo sblocco */
+    float *nb, *nr, *rb, *rr;     /* colore dei quadretti dopo lo sblocco; una riga interpolata in verticale */
+    int cw, ch;                   /* quadretti in orizzontale e in verticale */
+    double fx[8], fy[8];          /* salti medi accumulati per fase della griglia della luminanza */
+    double cx[2], cy[2];          /* salti del colore: blocchi alla fase +0 o +8 */
+    int px, py;                   /* fase della griglia 8x8 della luminanza (0..7) */
+    int pcx, pcy, pc_ok;          /* fase dei blocchi del colore (0..15) e se e' affidabile */
+    uint32_t mdec_conta;          /* contatore delle decodifiche MDEC all'ultimo fotogramma */
+    int senza_mdec;               /* presentazioni di fila senza decodifiche nuove */
+    int valido, q;                /* out corrisponde a src; quantizzazione usata */
+    int q_min, q_max;             /* quantizzazione piu' bassa e piu' alta viste (per il registro) */
+    uint64_t fotogrammi, rifatti; /* presentazioni filtrate e fotogrammi nuovi elaborati */
+    int annuncio;                 /* gia' scritto nel registro (fase e q) */
+} Sm2Filtro;
+static Sm2Filtro s_sm2;
+
+static int sm2_filtro_modo(void) {
+    if (!s_sm2.letto) {
+        const char *e = getenv("PSX_SM2_FILTRO_FILMATI");
+        s_sm2.letto = 1;
+        s_sm2.modo = (e && e[0] >= '1' && e[0] <= '3' && !e[1]) ? e[0] - '0' : 0;
+        if (s_sm2.modo) {
+            printf("[SM2-Recomp] filtro dei filmati in tempo reale acceso (modo %d)\n", s_sm2.modo);
+            fflush(stdout);
+        }
+    }
+    return s_sm2.modo;
+}
+
+static int sm2_spazio(int w, int h) {
+    const size_t n = (size_t)w * (size_t)h, nc = (size_t)(w / 2 + 2) * (size_t)(h / 2 + 2);
+    if (n <= s_sm2.cap && nc <= s_sm2.cap_c) return 1;
+    free(s_sm2.src); free(s_sm2.out); free(s_sm2.Y); free(s_sm2.Yd);
+    free(s_sm2.cb); free(s_sm2.cr); free(s_sm2.cbi); free(s_sm2.cri); free(s_sm2.cbd); free(s_sm2.crd);
+    free(s_sm2.nb); free(s_sm2.nr); free(s_sm2.rb); free(s_sm2.rr);
+    s_sm2.src = (uint32_t *)malloc(n * 4); s_sm2.out = (uint32_t *)malloc(n * 4);
+    s_sm2.Y = (int16_t *)malloc(n * 2); s_sm2.Yd = (int16_t *)malloc(n * 2);
+    s_sm2.cb = (float *)malloc(nc * sizeof(float)); s_sm2.cr = (float *)malloc(nc * sizeof(float));
+    s_sm2.cbi = (int16_t *)malloc(nc * 2); s_sm2.cri = (int16_t *)malloc(nc * 2);
+    s_sm2.cbd = (int16_t *)malloc(nc * 2); s_sm2.crd = (int16_t *)malloc(nc * 2);
+    s_sm2.nb = (float *)malloc(nc * sizeof(float)); s_sm2.nr = (float *)malloc(nc * sizeof(float));
+    s_sm2.rb = (float *)malloc((size_t)(w / 2 + 2) * sizeof(float));
+    s_sm2.rr = (float *)malloc((size_t)(w / 2 + 2) * sizeof(float));
+    s_sm2.valido = 0;
+    if (!s_sm2.src || !s_sm2.out || !s_sm2.Y || !s_sm2.Yd || !s_sm2.cb || !s_sm2.cr || !s_sm2.cbi || !s_sm2.cri ||
+        !s_sm2.cbd || !s_sm2.crd || !s_sm2.nb || !s_sm2.nr || !s_sm2.rb || !s_sm2.rr) {
+        s_sm2.cap = s_sm2.cap_c = 0;
+        return 0;
+    }
+    s_sm2.cap = n; s_sm2.cap_c = nc;
+    return 1;
+}
+
+static int sm2_lim(int v, int a, int b) { return v < a ? a : v > b ? b : v; }
+
+/* Attenua i bordi dei blocchi dove l'immagine e' piatta e il salto e' piccolo (stessa regola dei filmati Migliorati,
+ * tools/fmv/fmv_str.c): bordi alle colonne x = fx (mod passo) e alle righe y = fy (mod passo). */
+static void sm2_sblocca(int16_t *pl, int w, int h, int passo, int fx, int fy, int qscale) {
+    const int alfa = 2 + (3 * qscale) / 2, beta = 2 + qscale, tc = 1 + qscale / 2;
+    for (int pass = 0; pass < 2; ++pass) {
+        const int lim_i = pass == 0 ? w : h, lim_j = pass == 0 ? h : w, f = pass == 0 ? fx : fy;
+        for (int i = f; i < lim_i; i += passo) {
+            if (i < 3 || i > lim_i - 3) continue;
+            for (int j = 0; j < lim_j; ++j) {
+                int16_t *q = pass == 0 ? pl + (size_t)j * w + i : pl + (size_t)i * w + j;
+                const ptrdiff_t s = pass == 0 ? 1 : w;
+                const int p2 = q[-3 * s], p1 = q[-2 * s], p0 = q[-s], q0 = q[0], q1 = q[s], q2 = q[2 * s];
+                if (abs(q0 - p0) >= alfa || abs(p1 - p0) >= beta || abs(q1 - q0) >= beta) continue;
+                const int d = sm2_lim(((q0 - p0) * 4 + (p1 - q1) + 4) >> 3, -tc, tc);
+                q[-s] = (int16_t)(p0 + d);
+                q[0] = (int16_t)(q0 - d);
+                if (abs(p2 - p0) < beta)
+                    q[-2 * s] = (int16_t)(p1 + sm2_lim(((p2 + ((p0 + q0 + 1) >> 1)) >> 1) - p1, -tc / 2, tc / 2));
+                if (abs(q2 - q0) < beta)
+                    q[s] = (int16_t)(q1 + sm2_lim(((q2 + ((p0 + q0 + 1) >> 1)) >> 1) - q1, -tc / 2, tc / 2));
+            }
+        }
+    }
+}
+
+/* Fase della griglia 8x8: nelle zone piatte i salti tra pixel vicini sono piu' grandi sui bordi dei blocchi. Le medie
+ * si accumulano da un fotogramma all'altro, cosi' un fotogramma scuro o uniforme non sposta la griglia. */
+static int sm2_scegli(const double *v, int n, int attuale, double soglia) {
+    int b = 0;
+    double resto = 0;
+    for (int i = 1; i < n; ++i) if (v[i] > v[b]) b = i;
+    for (int i = 0; i < n; ++i) if (i != b) resto += v[i];
+    resto /= (double)(n - 1);
+    return (v[b] > resto * soglia && v[b] - resto > 0.05) ? b : attuale;
+}
+
+static void sm2_fasi_luma(const int16_t *Y, int w, int h) {
+    double sx[8] = { 0 }, sy[8] = { 0 };
+    long nx[8] = { 0 }, ny[8] = { 0 };
+    for (int y = 0; y < h; y += 2) {
+        const int16_t *r = Y + (size_t)y * w;
+        for (int x = 2; x + 1 < w; ++x) {
+            const int d = abs(r[x] - r[x - 1]);
+            if (d > 48 || abs(r[x - 1] - r[x - 2]) > 6 || abs(r[x + 1] - r[x]) > 6) continue;
+            sx[x & 7] += d; nx[x & 7]++;
+        }
+    }
+    for (int y = 2; y + 1 < h; ++y) {
+        const int16_t *a = Y + (size_t)(y - 2) * w, *b = a + w, *c = b + w, *e = c + w;
+        for (int x = 0; x < w; x += 2) {
+            const int d = abs(c[x] - b[x]);
+            if (d > 48 || abs(b[x] - a[x]) > 6 || abs(e[x] - c[x]) > 6) continue;
+            sy[y & 7] += d; ny[y & 7]++;
+        }
+    }
+    for (int p = 0; p < 8; ++p) {
+        s_sm2.fx[p] = 0.75 * s_sm2.fx[p] + (nx[p] ? sx[p] / (double)nx[p] : 0.0);
+        s_sm2.fy[p] = 0.75 * s_sm2.fy[p] + (ny[p] ? sy[p] / (double)ny[p] : 0.0);
+    }
+    s_sm2.px = sm2_scegli(s_sm2.fx, 8, s_sm2.px, 1.25);
+    s_sm2.py = sm2_scegli(s_sm2.fy, 8, s_sm2.py, 1.25);
+}
+
+/* Blocchi del colore (8x8 quadretti = 16x16 pixel): la griglia della luminanza dice la fase a meno di 8 pixel. */
+static void sm2_fasi_colore(void) {
+    const int cw = s_sm2.cw, ch = s_sm2.ch, ox = s_sm2.px & 1, oy = s_sm2.py & 1;
+    for (int k = 0; k < 2; ++k) {
+        const int bx = ((s_sm2.px + 8 * k + ox) >> 1) & 7, by = ((s_sm2.py + 8 * k + oy) >> 1) & 7;
+        double sx = 0, sy = 0;
+        long nx = 0, ny = 0;
+        for (int y = 0; y < ch; ++y)
+            for (int x = bx; x < cw; x += 8) {
+                if (x < 2 || x + 1 >= cw) continue;
+                const int16_t *b = s_sm2.cbi + (size_t)y * cw + x, *r = s_sm2.cri + (size_t)y * cw + x;
+                if (abs(b[-1] - b[-2]) > 4 || abs(b[1] - b[0]) > 4 || abs(r[-1] - r[-2]) > 4 || abs(r[1] - r[0]) > 4)
+                    continue;
+                sx += abs(b[0] - b[-1]) + abs(r[0] - r[-1]); nx++;
+            }
+        for (int y = by; y < ch; y += 8) {
+            if (y < 2 || y + 1 >= ch) continue;
+            for (int x = 0; x < cw; ++x) {
+                const int16_t *b = s_sm2.cbi + (size_t)y * cw + x, *r = s_sm2.cri + (size_t)y * cw + x;
+                if (abs(b[-cw] - b[-2 * cw]) > 4 || abs(b[cw] - b[0]) > 4 || abs(r[-cw] - r[-2 * cw]) > 4 ||
+                    abs(r[cw] - r[0]) > 4)
+                    continue;
+                sy += abs(b[0] - b[-cw]) + abs(r[0] - r[-cw]); ny++;
+            }
+        }
+        s_sm2.cx[k] = 0.75 * s_sm2.cx[k] + (nx ? sx / (double)nx : 0.0);
+        s_sm2.cy[k] = 0.75 * s_sm2.cy[k] + (ny ? sy / (double)ny : 0.0);
+    }
+    const int kx = s_sm2.cx[1] > s_sm2.cx[0] ? 1 : 0, ky = s_sm2.cy[1] > s_sm2.cy[0] ? 1 : 0;
+    const double rx = s_sm2.cx[kx] / (s_sm2.cx[1 - kx] + 1e-9), ry = s_sm2.cy[ky] / (s_sm2.cy[1 - ky] + 1e-9);
+    s_sm2.pcx = s_sm2.px + 8 * kx;
+    s_sm2.pcy = s_sm2.py + 8 * ky;
+    s_sm2.pc_ok = rx > 1.25 && ry > 1.25;
+}
+
+/* Parte sul processore: restituisce l'immagine da mandare alla scheda video (pixels se non c'e' niente da fare). */
+static const uint32_t *sm2_filtro_cpu(const uint32_t *pixels, int w, int h) {
+    if (w < 16 || h < 16 || !sm2_spazio(w, h)) return pixels;
+    const uint32_t conta = mdec_get_decode_count();
+    if (conta != s_sm2.mdec_conta) { s_sm2.mdec_conta = conta; s_sm2.senza_mdec = 0; }
+    else if (s_sm2.senza_mdec < 1000000) s_sm2.senza_mdec++;
+    if (s_sm2.senza_mdec > 90) return pixels;   /* niente MDEC da 1,5 s: non e' un filmato, si lascia com'e' */
+    s_sm2.fotogrammi++;
+    const size_t n = (size_t)w * (size_t)h;
+    if (s_sm2.valido && w == s_sm2.w && h == s_sm2.h && memcmp(pixels, s_sm2.src, n * 4) == 0) return s_sm2.out;
+    if (w != s_sm2.w || h != s_sm2.h) {
+        memset(s_sm2.fx, 0, sizeof s_sm2.fx); memset(s_sm2.fy, 0, sizeof s_sm2.fy);
+        memset(s_sm2.cx, 0, sizeof s_sm2.cx); memset(s_sm2.cy, 0, sizeof s_sm2.cy);
+        s_sm2.px = s_sm2.py = s_sm2.pcx = s_sm2.pcy = s_sm2.pc_ok = 0;
+    }
+    s_sm2.w = w; s_sm2.h = h;
+    memcpy(s_sm2.src, pixels, n * 4);
+    s_sm2.rifatti++;
+    /* quantizzazione dell'ultimo blocco decodificato; oltre 24 lo sblocco spianerebbe anche i dettagli veri (i filmati
+     * di Spider-Man 2 stanno molto sotto), quindi si ferma li' */
+    int q = (int)mdec_sm2_qscale();
+    if (q < 0) q = 0;
+    if (q > 24) q = 24;
+    s_sm2.q = q;
+    if (q < s_sm2.q_min || s_sm2.rifatti == 1) s_sm2.q_min = q;
+    if (q > s_sm2.q_max) s_sm2.q_max = q;
+    /* luminanza */
+    for (size_t i = 0; i < n; ++i) {
+        const uint32_t p = pixels[i];
+        const int r = (int)((p >> 16) & 0xFF), g = (int)((p >> 8) & 0xFF), b = (int)(p & 0xFF);
+        s_sm2.Y[i] = (int16_t)((19595 * r + 38470 * g + 7471 * b + 32768) >> 16);   /* BT.601 */
+    }
+    sm2_fasi_luma(s_sm2.Y, w, h);
+    /* colore medio dei quadretti 2x2 (allineati alla griglia dei blocchi) */
+    const int ox = s_sm2.px & 1, oy = s_sm2.py & 1;
+    const int cw = ((w - 1 + ox) >> 1) + 1, ch = ((h - 1 + oy) >> 1) + 1;
+    s_sm2.cw = cw; s_sm2.ch = ch;
+    for (int cy = 0; cy < ch; ++cy)
+        for (int cx = 0; cx < cw; ++cx) {
+            float sb = 0, sr = 0;
+            int k = 0;
+            for (int dy = 0; dy < 2; ++dy) {
+                const int y = 2 * cy - oy + dy;
+                if (y < 0 || y >= h) continue;
+                for (int dx = 0; dx < 2; ++dx) {
+                    const int x = 2 * cx - ox + dx;
+                    if (x < 0 || x >= w) continue;
+                    const uint32_t p = pixels[(size_t)y * w + x];
+                    const float r = (float)((p >> 16) & 0xFF), g = (float)((p >> 8) & 0xFF), b = (float)(p & 0xFF);
+                    sb += -0.168736f * r - 0.331264f * g + 0.5f * b;
+                    sr += 0.5f * r - 0.418688f * g - 0.081312f * b;
+                    k++;
+                }
+            }
+            const size_t c = (size_t)cy * cw + cx;
+            s_sm2.cb[c] = k ? sb / (float)k : 0.0f;
+            s_sm2.cr[c] = k ? sr / (float)k : 0.0f;
+            s_sm2.cbi[c] = (int16_t)lrintf(s_sm2.cb[c]);
+            s_sm2.cri[c] = (int16_t)lrintf(s_sm2.cr[c]);
+        }
+    sm2_fasi_colore();
+    /* sblocco */
+    memcpy(s_sm2.Yd, s_sm2.Y, n * 2);
+    memcpy(s_sm2.cbd, s_sm2.cbi, (size_t)cw * ch * 2);
+    memcpy(s_sm2.crd, s_sm2.cri, (size_t)cw * ch * 2);
+    if (q > 0) {
+        sm2_sblocca(s_sm2.Yd, w, h, 8, s_sm2.px, s_sm2.py, q);
+        if (s_sm2.pc_ok) {
+            const int bx = ((s_sm2.pcx + ox) >> 1) & 7, by = ((s_sm2.pcy + oy) >> 1) & 7;
+            sm2_sblocca(s_sm2.cbd, cw, ch, 8, bx, by, q);
+            sm2_sblocca(s_sm2.crd, cw, ch, 8, bx, by, q);
+        }
+    }
+    /* colore interpolato tra i centri dei quadretti e nuova immagine: si aggiungono solo le differenze, cosi' dove
+     * niente cambia il pixel resta identico. Il centro del quadretto c e' tra i pixel 2c - o e 2c - o + 1, quindi
+     * ogni pixel prende 3/4 dal suo quadretto e 1/4 dal vicino, in orizzontale e in verticale. */
+    for (size_t c = 0; c < (size_t)cw * ch; ++c) {
+        s_sm2.nb[c] = s_sm2.cb[c] + (float)(s_sm2.cbd[c] - s_sm2.cbi[c]);
+        s_sm2.nr[c] = s_sm2.cr[c] + (float)(s_sm2.crd[c] - s_sm2.cri[c]);
+    }
+    for (int y = 0; y < h; ++y) {
+        const int yc = (y + oy) >> 1, yv = sm2_lim(((y + oy) & 1) ? yc + 1 : yc - 1, 0, ch - 1);
+        const float *b0 = s_sm2.nb + (size_t)yc * cw, *b1 = s_sm2.nb + (size_t)yv * cw;
+        const float *r0 = s_sm2.nr + (size_t)yc * cw, *r1 = s_sm2.nr + (size_t)yv * cw;
+        for (int c = 0; c < cw; ++c) {
+            s_sm2.rb[c] = 0.75f * b0[c] + 0.25f * b1[c];
+            s_sm2.rr[c] = 0.75f * r0[c] + 0.25f * r1[c];
+        }
+        const float *cb0 = s_sm2.cb + (size_t)yc * cw, *cr0 = s_sm2.cr + (size_t)yc * cw;
+        const uint32_t *in = pixels + (size_t)y * w;
+        uint32_t *o = s_sm2.out + (size_t)y * w;
+        const int16_t *Y0 = s_sm2.Y + (size_t)y * w, *Y1 = s_sm2.Yd + (size_t)y * w;
+        for (int x = 0; x < w; ++x) {
+            const int xc = (x + ox) >> 1, xv = sm2_lim(((x + ox) & 1) ? xc + 1 : xc - 1, 0, cw - 1);
+            const float db = 0.75f * s_sm2.rb[xc] + 0.25f * s_sm2.rb[xv] - cb0[xc];
+            const float dr = 0.75f * s_sm2.rr[xc] + 0.25f * s_sm2.rr[xv] - cr0[xc];
+            const float dy = (float)(Y1[x] - Y0[x]) + 0.5f;     /* + 0,5: arrotondamento */
+            const uint32_t p = in[x];
+            const int r = sm2_lim((int)floorf((float)((p >> 16) & 0xFF) + dy + 1.402f * dr), 0, 255);
+            const int g = sm2_lim((int)floorf((float)((p >> 8) & 0xFF) + dy - 0.344136f * db - 0.714136f * dr), 0, 255);
+            const int b = sm2_lim((int)floorf((float)(p & 0xFF) + dy + 1.772f * db), 0, 255);
+            o[x] = (p & 0xFF000000u) | ((uint32_t)r << 16) | ((uint32_t)g << 8) | (uint32_t)b;
+        }
+    }
+    s_sm2.valido = 1;
+    if (s_sm2.annuncio < 3 && (s_sm2.rifatti == 30 || s_sm2.rifatti == 600 || s_sm2.rifatti == 6000)) {
+        s_sm2.annuncio++;
+        printf("[SM2-Recomp] filtro dei filmati: %dx%d, griglia %d,%d, colore %d,%d (%s), quantizzazione %d (da %d a %d), "
+               "fotogrammi %llu su %llu presentazioni\n", w, h, s_sm2.px, s_sm2.py, s_sm2.pcx, s_sm2.pcy,
+               s_sm2.pc_ok ? "trovata" : "incerta", q, s_sm2.q_min, s_sm2.q_max, (unsigned long long)s_sm2.rifatti,
+               (unsigned long long)s_sm2.fotogrammi);
+        fflush(stdout);
+    }
+    return s_sm2.out;
+}
+
+/* Il modo del disegno per questa presentazione: SM2_MODO_FILTRO o filt_mode com'era. */
+static int sm2_filtro_attivo(int filt_mode, int src_w, int src_h, int out_w, int out_h) {
+    if (filt_mode < 0 || !s_present_d24) return 0;
+    if (!sm2_filtro_modo()) return 0;
+    return src_w > 0 && src_h > 0 && out_w >= src_w && out_h >= src_h;
+}
