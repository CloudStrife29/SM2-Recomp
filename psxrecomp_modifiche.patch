+/* Chiamata da refresh_host_display_cadence a ogni cambio di schermo o di refresh. */
+static void sm2_ritmo_aggiorna(double host_hz) {
+    const int modo = sm2_ritmo_modo();
+    const int k = modo >= 1 ? sm2_ritmo_multiplo(host_hz) : 0;
+    const int prima = s_sm2_k.load();
+    s_sm2_hz = host_hz;
+    s_sm2_k.store(k);
+#if defined(_WIN32) && !defined(PSX_SDL_NO_RENDER)
+    if (k && !gl_renderer_sm2_swap)
+        gl_renderer_sm2_swap = sm2_ritmo_swap;
+    if (k != prima || s_sm2_scan_stato > 0) {
+        if (s_sm2_scan_stato > 0)
+            s_sm2_scan_stato = 0;     /* schermo o refresh cambiati: si riapre */
+        sm2_ritmo_azzera();
+    }
+#else
+    (void)prima;
+#endif
+}
